// Grenoble INP - Ensimag projet GL -*- mode: java -*-
// Library for class Point of Deca, coded in Deca

class Point {

    float x = 0.0;
    float y = 0.0;
    float angle = 0.0;

    void setXY(float x, float y){
        this.x = x;
        this.y = y;
    }

    float getX() {
        return x;
    }

    void setX(float x) {
        this.x = x;
    }

    float getY() {
        return y;
    }

    void setY(float y) {
        this.y = y;
    }

    float getAngle() {
        return angle;
    }

    void setAngle(float angle) {
        this.angle = angle;
    }
}