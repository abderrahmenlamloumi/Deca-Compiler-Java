    void onMPressed(){

        colorCode = 42;
        drawEnsimag(12.0, 4.0, 4.0);
        time.sleep(1);

        colorCode = 41;
        drawEnsimag(12.0, 16.0, 16.0);
        time.sleep(1);

        colorCode = 44;
        drawEnsimag(12.0, 28.0, 28.0);
        time.sleep(1);

        colorCode = 45;
        drawEnsimag(12.0, 40.0, 40.0);
        time.sleep(1);

        colorCode = 46;
        drawEnsimag(12.0, 52.0, 52.0);
        time.sleep(1);
    }


