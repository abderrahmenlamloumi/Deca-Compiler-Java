        // S

        size = 12;
        i = 0;
        points = new Point[size];
        while (i < size){
           points[i] = new Point();
           i = i + 1;
        }

        offsetX = offsetX + space + 3;

        points[0].setXY(offsetX,offsetY);
        points[1].setXY(offsetX,offsetY + 6);
        points[2].setXY(offsetX + 6 ,offsetY + 6);
        points[3].setXY(offsetX + 6 ,offsetY + 8);
        points[4].setXY(offsetX ,offsetY + 8);
        points[5].setXY(offsetX ,offsetY + 10);
        points[6].setXY(offsetX + 9 ,offsetY + 10);
        points[7].setXY(offsetX + 9 ,offsetY + 4);
        points[8].setXY(offsetX + 3 ,offsetY + 4);
        points[9].setXY(offsetX + 3 ,offsetY + 2);
        points[10].setXY(offsetX + 9 ,offsetY + 2);
        points[11].setXY(offsetX + 9 ,offsetY);

        onHPressed();
        //time.sleep(1);
