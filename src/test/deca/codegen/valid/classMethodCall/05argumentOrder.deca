//Teste l’appel chaîné de méthodes avec des expressions contenant des affectations comme arguments, pour vérifier l’ordre d’évaluation, les effets de bord, et le bon fonctionnement de la création et de l’utilisation d’objets.
class CalculatorFactory {
    Calculator create(int x, int y) {
        println("Creating a new super calculator using seed ", x * y);
        return new Calculator();
    }
}

class Calculator {
    int add(int a, int b) {
        return a + b;
    }
}

{
    int x = 5;
    int y = 13;
    println(new CalculatorFactory().create(x, y).add((y = x + 1), (x = y * 2)));
    println(x, " ", y);
}
