// Description:
//    Programme minimaliste assignant des float avec un ou plusieurs moins unaires
//
// Resultats:
//    -4.00000e+00
//    5.50000e+00
//    -6.06000e+00
//
// Historique:
//    cree le 08/04/2025

{
        float z = -4.0;
        println(z);
        z = --5.5;
        println(z);
        z = ---6.06;
        println(z);
}
