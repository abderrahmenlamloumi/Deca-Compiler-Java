//test d'acces et definition des variables contenus dans deux tableaux
{
    int[] tab = new int[10];
    int[] vector = new int[20];
    int i = 0;

    while (i < 20) {
        vector[i] = i * 2;
        i = i + 1;
    }
    i = 0;
    while (i < 10) {
        tab[i] = (vector[i] / 2) + 1;
        println("tab[", i, "] : ", tab[i]);
        i = i + 1;
    }
}
