// Verify that a null check is done after evaluating the right-hand side of an assignment
// https://docs.oracle.com/javase/specs/jls/se21/html/jls-15.html#jls-15.26.1
class A {
    int x;
    int get() {
        println("A.get");
        return 5;
    }
}
{
    A a = null;
    a.x = new A().get();
    println(a.x);
}
