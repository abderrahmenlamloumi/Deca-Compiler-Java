//test de verification de la sauvegarde des registres (calcul de TSTO)
// runtime-options: -p 20
class Foo {
    void foo(float f) {
        println(bar(f) + bar(f) + bar(f));
    }

    int bar(float x) {
        int foo = 5;
        int bar = 6;
        println(x);
        return 12 + (bar + foo);
    }
}

{
    Foo foo = new Foo();
    foo.foo(4.0);
}
