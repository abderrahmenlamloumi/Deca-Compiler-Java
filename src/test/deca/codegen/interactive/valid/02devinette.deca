{
    int secret = 421, user;
    println("Quel est mon nombre entre 0 et 1000 ?");
    user = readInt();
    while (!(user == secret)) {
        if (user < secret) {
            print("Trop petit !");
        } else {
            print("Trop grand !");
        }
        println(" Autre proposition ?");
        user = readInt();
    }
    println("Bravo...");
}
